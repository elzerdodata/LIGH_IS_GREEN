+    std::this_thread::sleep_for(std::chrono::milliseconds(45));
+    send_keyboard_button(9, true);
+    std::this_thread::sleep_for(std::chrono::milliseconds(45));
+    send_keyboard_button(9, false);
+    std::this_thread::sleep_for(std::chrono::milliseconds(45));
+    send_keyboard_button(18, false);
+}
